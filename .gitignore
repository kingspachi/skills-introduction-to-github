# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Grandview CPA automation: NEVER commit client data ---
grandview/clients/**
!grandview/clients/.gitkeep
!grandview/clients/README.md
grandview/workpapers/**
!grandview/workpapers/.gitkeep
*.client.*
*_PII.*

# Grandview runtime artifacts
grandview/system/skills/notifications.log
grandview/system/skills/.seen_files.txt
grandview/**/__pycache__/
grandview/.pytest_cache/
